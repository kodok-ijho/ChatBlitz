{
  "name": "nara-ai-agent-builder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx --env-file-if-exists=.env server.ts",
    "ingest:laundry": "tsx --env-file-if-exists=.env scripts/ingestLaundryData.ts",
    "memory:check": "tsx --env-file-if-exists=.env scripts/checkChatMemorySchema.ts",
    "waha:webhook": "tsx --env-file-if-exists=.env scripts/configureWahaWebhook.ts",
    "build": "tsc && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "@xyflow/react": "^12.10.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
